{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(uv:*)",
      "Bash(poetry:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(tsc:*)",
      "Bash(dotnet:*)",
      "Bash(nuget:*)",
      "Bash(msbuild:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustfmt:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(bundle:*)",
      "Bash(rails:*)",
      "Bash(ruby:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!./.env.example)",
      "Read(!./.env.sample)",
      "Read(!./.env.template)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(!**/.env.template)",
      "Read(**/secrets.json)",
      "Read(**/appsettings.Local.json)",
      "Read(**/appsettings.local.json)",
      "Read(**/local.settings.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Bash(cat .env)",
      "Bash(type .env)",
      "Bash(Get-Content .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Read(**/*.parquet)",
      "Read(**/*.xlsx)",
      "Read(**/*.db)",
      "Read(**/*.sqlite)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_python_hook.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_access.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[context-engineering] Read CLAUDE.md for project rules. Check HANDOFF.md - if present, read it first; the previous session left context. Workflow: /new-feature (or edit PRPs/source/INITIAL.md), then /generate-prp, then /execute-prp PRPs/<slug>.md. Slash commands: /new-feature, /generate-prp, /execute-prp, /handoff, /deploy-status. Reference: PRPs/README.md for the full PRP guide.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
