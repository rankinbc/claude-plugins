{
  "description": "Deny lists shared by the hooks (src/courier/guard*.py) and the PowerShell ops. Regex fragments match case-insensitively against canonical paths (forward slashes, lower-case). A developer overlay at ~/.secret-courier/guard-policy.json may only TIGHTEN the guard: it can ADD entries to denied_file_families, denied_dirs, denied_samples and value_dump_tokens, and set `paste`. It can never add an allow (allowed_files, allowed_dirs), widen the metadata/safe-git/trusted-script/interpreter lists, or change anything else; such keys are ignored (reported by `courier doctor`). allowed_files are anchored repo-relative, not matched anywhere.",
  "denied_file_families": [
    "\\.env(?:\\.[\\w-]+)*",
    "\\.envrc",
    "appsettings\\.(?:local|secrets|development)\\.json",
    "local\\.settings\\.json",
    "launchsettings\\.json",
    "secrets\\.(?:json|ya?ml|toml)",
    "\\.git-credentials",
    "\\.gitconfig",
    "\\.npmrc",
    "\\.pypirc",
    "\\.netrc",
    "_netrc",
    "\\.pgpass",
    "nuget\\.config",
    "terraform\\.tfstate(?:\\.backup)?",
    "terraform\\.tfvars",
    "\\.m2/settings\\.xml",
    "id_(?:rsa|dsa|ecdsa|ed25519)",
    "\\.claude\\.json",
    "[^/]+\\.(?:pfx|pem|key|pubxml|publishsettings|p12|jks|ppk|keystore|p8)",
    "\\.git/config",
    "\\.claude/\\.credentials\\.json",
    "\\.docker/config\\.json",
    "\\.kube/config",
    "\\.aws/credentials",
    "(?:gh|github[ ]cli)/hosts\\.yml",
    "proc/(?:self|\\d+)/environ"
  ],
  "denied_dirs": [".secret-courier", ".azure", ".ssh", ".aws", ".kube", ".gnupg"],
  "denied_samples": [
    ".env", ".env.local", ".envrc", "appsettings.local.json", "appsettings.secrets.json", "appsettings.development.json",
    "local.settings.json", "launchsettings.json", "secrets.json", "secrets.yaml", "secrets.toml", ".git-credentials",
    ".gitconfig", ".npmrc", ".pypirc", ".netrc", "_netrc", ".pgpass", "nuget.config", "terraform.tfstate",
    "terraform.tfvars", ".m2/settings.xml", "id_rsa", "id_ed25519", ".claude.json", "cert.pfx", "key.pem",
    "private.key", "site.pubxml", "site.publishsettings", "cert.p12", "store.jks", "key.ppk", "release.keystore",
    "authkey.p8", ".git/config", ".claude/.credentials.json", ".docker/config.json", ".kube/config",
    ".aws/credentials", "gh/hosts.yml", "proc/self/environ"
  ],
  "allowed_files": ["\\.env\\.(?:example|template|sample)", "\\.secret-courier/secrets\\.manifest\\.json", "\\.secret-courier/sinks\\.json", "\\.secret-courier/guard-policy\\.json", "\\.secret-courier/config\\.json", "\\.secret-courier/audit\\.jsonl"],
  "allowed_dirs": [],
  "secret_env_names": "(?:[A-Z][A-Z0-9]*_)*(?:PAT|TOKEN|SECRET|PASSWORD|PASSWD|PWD|API_?KEY|ACCESS_KEY|PRIVATE_KEY|CLIENT_SECRET|KEY)(?:_[A-Z0-9]+)*",
  "value_dump_tokens": [
    "Get-CourierSecretValue",
    "Get-CourierStoreValue",
    "ConvertFrom-CourierSecureString",
    "Courier\\.psm1",
    "CourierSinks\\.psm1",
    "CourierCred",
    "CredReadW?",
    "Unprotect-CmsMessage",
    "ProtectedData\\]?::Unprotect",
    "NetworkCredential",
    "SecureStringToBSTR",
    "ConvertFrom-SecureString",
    "PtrToStringBSTR",
    "Unprotect-SecureString",
    "Get-StoredCredential",
    "Get-Secret",
    "get_password\\s*\\(",
    "dotenv_values\\s*\\(",
    "load_dotenv\\s*\\(",
    "keyring\\s+get",
    "import\\s+keyring",
    "from\\s+keyring",
    "from\\s+dotenv",
    "dotenv\\s+(?:get|list)",
    "user-secrets\\s+list",
    "cmdkey",
    "GetEnvironmentVariables\\s*\\(",
    "printenv",
    "process\\.env(?![\\w.\\[])",
    "Deno\\.env\\.toObject\\s*\\(",
    "ENV\\.(?:to_h|to_a|each|map|keys|inspect|select|filter)",
    "(?:p|puts|print)\\s+ENV",
    "%ENV",
    "\\$_ENV",
    "getenv\\s*\\(\\s*\\)",
    "declare\\s+-x",
    "export\\s+-p",
    "az\\s+keyvault\\s+secret\\s+(?:show|download|backup)",
    "az\\s+account\\s+get-access-token",
    "az\\s+\\S+(?:\\s+\\S+)*?\\s+(?:list-keys|list-connection-strings|list-publishing-profiles|list-publishing-credentials)",
    "az\\s+\\S+(?:\\s+\\S+)*?\\s+keys\\s+list",
    "az\\s+webapp\\s+config\\s+(?:appsettings|connection-string)\\s+list",
    "ConvertFrom-CourierSecureString",
    "aws\\s+secretsmanager\\s+get-secret-value",
    "aws\\s+ssm\\s+get-parameters?\\b[^|;&]*--with-decryption",
    "gcloud\\s+secrets\\s+versions\\s+access",
    "vault\\s+(?:kv\\s+get|read)\\b",
    "op\\s+(?:read|item\\s+get)\\b",
    "gh\\s+auth\\s+token",
    "kubectl\\s+get\\s+secrets?\\b[^|;&]*(?:-o|--output)"
  ],
  "interpreters": ["python", "python3", "py", "node", "deno", "bun", "ruby", "perl", "php", "pwsh", "powershell", "bash", "sh", "zsh", "cmd"],
  "metadata_programs": ["ls", "dir", "get-childitem", "gci", "test-path", "resolve-path", "get-item", "gi", "stat", "test", "[", "join-path", "split-path", "file", "du", "wc"],
  "safe_git": ["check-ignore", "status", "ls-files"],
  "trusted_script_dirs": ["powershell/ops", "scripts/secure"],
  "paste": "advise"
}
