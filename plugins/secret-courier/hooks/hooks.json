{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "timeout": 30,
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}\\scripts\\courier-session.cmd"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "timeout": 60,
            "onFailure": "block",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}\\scripts\\courier-guard.cmd",
              "--bash-hook"
            ]
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "timeout": 60,
            "onFailure": "block",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}\\scripts\\courier-guard.cmd",
              "--read-hook"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "timeout": 60,
            "onFailure": "block",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}\\scripts\\courier-guard.cmd",
              "--write-hook"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "timeout": 60,
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}\\scripts\\courier-guard.cmd",
              "--prompt-hook"
            ]
          }
        ]
      }
    ]
  }
}
