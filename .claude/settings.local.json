      "Bash(gh auth *)",
      "Bash(git init *)",
      "Bash(git add *)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[claude-prp-scaffold] Read CLAUDE.md for rules. If starting a new project, run /new-project — Claude guides you through scoping, research, and scaffolding. Otherwise use the base PRP workflow: edit INITIAL.md then /generate-prp INITIAL.md then /execute-prp PRPs/<slug>.md. Check HANDOFF.md if present. Slash commands: /new-project (guided scaffolder), /generate-prp, /execute-prp, /handoff.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
